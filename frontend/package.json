{
  "name": "passkey-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently --kill-others --names API,WEB --prefix-colors cyan,green \"npm run start:api\" \"npm run start:frontend\"",
    "start:api": "dotnet run --project ../backend/PasskeyDemo.Api --launch-profile https",
    "start:frontend": "ng serve --host localhost --port 4200 --ssl --ssl-cert ../certs/localhost.pem --ssl-key ../certs/localhost.key",
    "build": "ng build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@simplewebauthn/browser": "14.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "^1.56.0",
    "concurrently": "10.0.6",
    "typescript": "~6.0.0"
  }
}
